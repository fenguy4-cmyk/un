					<Item class="LocalScript" referent="RBXD5EA2E9ECA93498BADDA6AD981A9329E">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local Button = script.Parent
local RunService = game:GetService("RunService")

local Speed = 1 -- higher = faster rainbow
local Hue = 0

RunService.RenderStepped:Connect(function(dt)
	Hue += dt * Speed
	if Hue > 1 then
		Hue -= 1
	end
	Button.ImageColor3 = Color3.fromHSV(Hue, 1, 1)
end)
]]></ProtectedString>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
